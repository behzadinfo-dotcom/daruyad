name: Build APK v2.8

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # تغییرات کوچک روی فایل‌های بزرگ از روی پچ اعمال و روی main ثبت می‌شود
      - name: Apply v2.8 changes
        id: apply
        run: |
          if [ -f .github/v2.8-ui.patch ]; then
            git apply --whitespace=nowarn .github/v2.8-ui.patch
            git rm -q -f .github/v2.8-ui.patch
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add app
            git commit -q -m "v2.8: apply UI and data changes"
            if git push origin HEAD:main; then
              echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
            else
              echo "push of applied changes skipped"
            fi
          fi

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      # پروژه gradlew ندارد؛ همان نسخهٔ Gradle که در gradle-wrapper.properties است نصب می‌شود
      - name: Set up Gradle 9.3.1
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 9.3.1

      - name: Create debug keystore (CI only)
        run: |
          keytool -genkeypair -v -keystore debug.keystore -storepass android -keypass android \
            -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 \
            -dname "CN=Android Debug,O=Android,C=US"

      - name: Build debug APK
        run: gradle :app:assembleDebug --no-daemon --stacktrace

      - name: Rename APK
        run: cp app/build/outputs/apk/debug/app-debug.apk DaruYad-v2.8.apk

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: DaruYad-v2.8
          path: DaruYad-v2.8.apk

      - name: Publish release v2.8
        if: github.event_name == 'push'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v2.8
          target_commitish: ${{ steps.apply.outputs.sha || github.sha }}
          name: DaruYad v2.8
          files: DaruYad-v2.8.apk
          overwrite_files: true
          fail_on_unmatched_files: true
